[package]
name = "{{project-name}}"
description = "{{description}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.96"
publish = false

[dependencies]
pc-config = { git = "https://github.com/tess-fun/pieces", tag = "{{stack_tag}}" }
pc-error = { git = "https://github.com/tess-fun/pieces", tag = "{{stack_tag}}" }
pc-telemetry = { git = "https://github.com/tess-fun/pieces", tag = "{{stack_tag}}" }

clap = { version = "4", features = ["derive", "env"] }
serde = { version = "1", features = ["derive"] }
tracing = "0.1"

[dev-dependencies]
pc-testkit = { git = "https://github.com/tess-fun/pieces", tag = "{{stack_tag}}" }
assert_cmd = "2"
serde_json = "1"
predicates = "3"

[lints.rust]
unsafe_code = "forbid"
unreachable_pub = "warn"

[lints.clippy]
pedantic = { level = "warn", priority = -1 }
unwrap_used = "warn"
expect_used = "warn"
todo = "warn"
dbg_macro = "warn"
module_name_repetitions = "allow"
missing_errors_doc = "allow"
# Unlike the pieces libraries, this crate is a binary: writing to stdout and
# stderr is its job, not a lint violation.

[profile.release]
lto = "thin"
codegen-units = 1
strip = "debuginfo"
